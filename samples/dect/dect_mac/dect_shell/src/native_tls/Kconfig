config DESH_NATIVE_TLS
	bool "Custom AT%CMNG command to store credentials for native TLS to settings"
	depends on SETTINGS
	default n
	select AT_CMD_CUSTOM
	help
	  Enable custom AT%CMNG command to store TLS credentials to settings
	  for native TLS usage.
	  When enabled, the AT%CMNG command can be used to store TLS credentials
	  (CA certificate, client certificate, private key) to the settings
	  storage, from where native TLS (Mbed TLS) can load them when
	  establishing a TLS connection.
	  Note: This feature requires SETTINGS to be enabled and as a default in desh, settings
	  is unsecured storage, this feature should not be used in production
	  devices without adding additional security to protect the
	  stored credentials.

if DESH_NATIVE_TLS

config DESH_NATIVE_TLS_CREDENTIAL_BUFFER_SIZE
	int "Buffer space reserved for loading credentials"
	default 4096
	help
	  Buffer space available for a single sec_tag when loading credentials for Mbed TLS.

config DESH_NATIVE_TLS_CREDENTIAL_BUFFER_COUNT
	int "Amount of buffers for loading credentials"
	default 1
	range 1 2
	help
	  Amount of buffers available for loading sec_tag credentials for Mbed TLS.
	  TLS client needs the buffer only when connecting whereas TLS server needs the buffer as long as it is running.
	  Increase the value, if you need TLS client and server running simultaneously with different sec_tags.

endif